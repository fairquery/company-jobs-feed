{
  "name": "@fairquery/company-jobs-feed-mcp",
  "version": "1.0.1",
  "mcpName": "io.github.fairquery/company-jobs-feed-mcp",
  "description": "stdio MCP server for Fairquery Company Jobs Feed: live jobs from Greenhouse, Lever and Ashby official public APIs (free local tools + paid Apify Actor tool).",
  "type": "module",
  "bin": {
    "company-jobs-feed-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "sync:check": "node scripts/sync-shared.mjs --check",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node scripts/sync-shared.mjs --check && node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "author": "Fairquery <fairquery@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fairquery/company-jobs-feed.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "jobs",
    "greenhouse",
    "lever",
    "ashby",
    "job-board-api",
    "ats"
  ],
  "homepage": "https://github.com/fairquery/company-jobs-feed/tree/main/mcp#readme",
  "bugs": {
    "url": "https://github.com/fairquery/company-jobs-feed/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
